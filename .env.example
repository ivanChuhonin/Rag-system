# Скопируй в .env и заполни своими значениями. .env — в .gitignore,

# --- VK API (vk_parse.py) ---
VK_ACCESS_TOKEN=

# --- Ollama (ask.py --llm ollama) ---
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:cloud
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=400
OLLAMA_TOP_K=20
OLLAMA_TIMEOUT=60

# --- GigaChat (ask.py --llm gigachat) ---
# Authorization key из личного кабинета GigaChat API.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
GIGACHAT_TEMPERATURE=0.3
GIGACHAT_MAX_TOKENS=400
GIGACHAT_TIMEOUT=60
GIGACHAT_VERIFY_SSL=false
